# =============================================================================
# Bachata Napoli — Environment Variables
#
# Skopiuj do `.env.local` i wypełnij wartościami.
# NIGDY nie commituj `.env.local` ani prawdziwych kluczy.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public env (prefix VITE_ jest wymagany, exposed do browser)
# -----------------------------------------------------------------------------
# Local dev (po `bunx supabase start` — wymaga Dockera):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<wartość z `bunx supabase status` → API key (anon)>
#
# Staging/Prod: kopiuj z Supabase Cloud Dashboard → Project Settings → API.
# Anon key jest publiczny (designed for browser exposure) — RLS na tabelach
# jest jedyną linią obrony. Service role key NIGDY tu nie wchodzi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase — Google OAuth (IU-3 dostarczy credentials)
# -----------------------------------------------------------------------------
# Te zmienne czytane są przez supabase/config.toml (`auth.external.google`).
# Trzymane w `.env.local` (nie commituje się). Sekret OAuth NIGDY w VITE_*.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
