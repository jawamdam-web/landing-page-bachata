# =============================================================================
# Bachata Napoli — Environment Variables
#
# Skopiuj do `.env.local` i wypełnij wartościami.
# NIGDY nie commituj `.env.local` ani prawdziwych kluczy.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public env (prefix VITE_ jest wymagany, exposed do browser)
# -----------------------------------------------------------------------------
# Local dev (po `bunx supabase start` — wymaga Dockera):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<wartość z `bunx supabase status` → API key (anon)>
#
# Staging/Prod: kopiuj z Supabase Cloud Dashboard → Project Settings → API.
# Anon key jest publiczny (designed for browser exposure) — RLS na tabelach
# jest jedyną linią obrony. Service role key NIGDY tu nie wchodzi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase — Google OAuth (IU-3)
# -----------------------------------------------------------------------------
# Te zmienne czytane są przez supabase/config.toml (`auth.external.google`).
# Trzymane w `.env.local` (nie commituje się). Sekret OAuth NIGDY w VITE_*.
#
# Wartości z: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Osobne Client ID dla staging i prod — patrz docs/operations/gcp-setup.md (Sekcja 4).
# Sekret wgrywa się również do Supabase Dashboard → Authentication → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Frontend Google OAuth Client ID (opcjonalnie — używane TYLKO jeśli kiedyś
# zechcemy obejść Supabase i wywoływać Google Identity Services bezpośrednio
# z browsera). W MVP zostaw PUSTE — Supabase Auth obsługuje OAuth flow
# server-side, frontend nie potrzebuje Client ID.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# -----------------------------------------------------------------------------
# YouTube Data API v3 — server-side (Edge Functions)
# -----------------------------------------------------------------------------
# API key z restrykcją do YouTube Data API v3 (nie OAuth Client). Używany przez
# Edge Function `fetch-youtube-metadata` (IU-8) do anonimowego fetch'u metadanych
# publicznych filmów po video ID.
#
# Wartość z: GCP Console → APIs & Services → Credentials → API key.
# Osobne klucze dla staging i prod.
# Wgrywany do Supabase secrets, NIE do .env.local repo:
#   bunx supabase secrets set YOUTUBE_API_KEY=<value> --project-ref <ref>
#
# Runbook: docs/operations/gcp-setup.md (Sekcja 5).
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Meta (Facebook/Instagram) — server-side (Edge Functions)
# -----------------------------------------------------------------------------
# WAŻNE: Pre-flight check — sprawdź AKTUALNY status oEmbed API w 2026 PRZED
# konfiguracją. Meta zmienia politykę embed wielokrotnie.
# Wybór planu w docs/operations/meta-developer-setup.md (Sekcja 0):
#   Plan A: oEmbed Read z Meta App → wypełnij oba poniżej
#   Plan B: manual entry embed code → zostaw oba PUSTE (kod aplikacji obsłuży)
#   Plan C: skip R11 w MVP → zostaw oba PUSTE
#
# Wartości z (Plan A): Meta for Developers Dashboard → Settings → Basic.
# App Secret NIGDY w VITE_* ani w kodzie frontendu.
# Wgrywane do Supabase secrets:
#   bunx supabase secrets set META_APP_ID=<value> --project-ref <ref>
#   bunx supabase secrets set META_APP_SECRET=<value> --project-ref <ref>
META_APP_ID=
META_APP_SECRET=
