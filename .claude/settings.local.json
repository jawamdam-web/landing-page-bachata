  "permissions": {
    "allow": [
      "Bash(git clone *)",
      "Bash(gh auth *)",
      "Bash(git init *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(gh repo *)",
      "Bash(git checkout *)",
      "Bash(bun --version)",
      "Bash(npm --version)",
      "Bash(curl -fsSL https://bun.sh/install)",
      "Bash(bash)",
      "Bash(~/.bun/bin/bun *)",
